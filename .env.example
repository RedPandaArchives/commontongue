# DeepL free-tier API key — get one at https://www.deepl.com/pro-api
# This stays on the server and is never sent to the browser.
DEEPL_API_KEY=your-deepl-key-here

# Secret used to sign login tokens. Any long random string works.
JWT_SECRET=change-this-to-any-long-random-string

# Port the server listens on (optional, defaults to 3001).
PORT=3001
